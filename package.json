{
  "name": "pi-kit",
  "version": "0.1.0",
  "description": "Personal pi extension collection for pi — vigil-todo and more",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spoon94/pi-kit.git"
  },
  "homepage": "https://github.com/Spoon94/pi-kit#readme",
  "bugs": {
    "url": "https://github.com/Spoon94/pi-kit/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "todo",
    "background-jobs",
    "task-board"
  ],
  "files": [
    "extensions",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!docs/**/design"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/vigil-todo.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "coverage:check": "vitest run --coverage",
    "verify": "npm test && npm run typecheck && npm run coverage:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typebox": "^1.4.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
